<Window x:Class="DeskGrid.Settings.ChangeLogWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="560"
        Height="620"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20,16,20,20">
    <!-- Modal, so Esc (IsCancel) closes it. -->
    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="84" Padding="12,5"
            x:Name="CloseButton" IsCancel="True" IsDefault="True" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Entries" Margin="0,0,12,0" />
    </ScrollViewer>
  </DockPanel>
</Window>
