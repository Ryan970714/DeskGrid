<Window x:Class="DeskGrid.Settings.NewFolderDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20,16,20,20">
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="Prompt" Style="{StaticResource CardTitle}" />
        <TextBox x:Name="NameBox" VerticalContentAlignment="Center" Padding="6,5" />
      </StackPanel>
    </Border>
    <TextBlock x:Name="Error" Margin="2,4,0,0" Foreground="#C42B1C" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="84" Padding="12,5" x:Name="OkButton" IsDefault="True" Click="OnOk" />
      <Button MinWidth="84" Padding="12,5" x:Name="CancelButton" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
