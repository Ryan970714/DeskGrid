<Window x:Class="DeskGrid.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Padding" Value="0,3,0,0" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,16,6" />
    </Style>
  </Window.Resources>

  <StackPanel Width="480" Margin="20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock x:Name="RootLabel" Style="{StaticResource Label}" />
      <DockPanel Grid.Column="1" Margin="0,0,0,16">
        <Button x:Name="BrowseButton" DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" Click="OnBrowse" />
        <TextBox x:Name="RootBox" VerticalContentAlignment="Center" />
      </DockPanel>

      <TextBlock x:Name="ColumnsLabel" Grid.Row="1" Style="{StaticResource Label}" />
      <ComboBox x:Name="ColumnsBox" Grid.Row="1" Grid.Column="1" Width="80" Margin="0,0,0,16" HorizontalAlignment="Left" />

      <TextBlock x:Name="DropModeLabel" Grid.Row="2" Style="{StaticResource Label}" TextWrapping="Wrap" MaxWidth="160" />
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,3,0,10" Orientation="Horizontal">
        <RadioButton x:Name="DropMove" GroupName="DropMode" />
        <RadioButton x:Name="DropCopy" GroupName="DropMode" />
      </StackPanel>

      <TextBlock x:Name="BackgroundLabel" Grid.Row="3" Style="{StaticResource Label}" />
      <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,3,0,0">
        <RadioButton x:Name="BackgroundSystem" GroupName="Background" />
        <RadioButton x:Name="BackgroundDark" GroupName="Background" />
        <RadioButton x:Name="BackgroundLight" GroupName="Background" />
        <RadioButton x:Name="BackgroundCustom" GroupName="Background" />
        <StackPanel Margin="22,2,0,0" IsEnabled="{Binding IsChecked, ElementName=BackgroundCustom}">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="ColorSwatch" Width="22" Height="22" BorderBrush="#80808080" BorderThickness="1" CornerRadius="3" />
            <Button x:Name="ColorButton" MinWidth="80" Margin="8,0,0,0" Click="OnPickColor" />
          </StackPanel>
          <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <TextBlock x:Name="OpacityLabel" Margin="0,0,8,0" VerticalAlignment="Center" />
            <Slider x:Name="OpacitySlider" Width="140" VerticalAlignment="Center" Minimum="0.1" Maximum="1"
                    SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" />
            <TextBlock Width="40" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>

    <TextBlock x:Name="Error" Margin="0,16,0,0" Foreground="#C42B1C" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="OkButton" MinWidth="80" IsDefault="True" Click="OnOk" />
      <!-- IsCancel only maps Esc to this button; a modeless window still has to close itself. -->
      <Button x:Name="CancelButton" MinWidth="80" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
