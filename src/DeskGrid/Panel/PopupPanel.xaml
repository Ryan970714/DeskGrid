<Window x:Class="DeskGrid.Panel.PopupPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowDrop="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}">
  <Window.Resources>
    <!-- Set from the theme in code. -->
    <SolidColorBrush x:Key="HoverBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TileBrush" Color="Transparent" />

    <Style x:Key="ItemButton" TargetType="Button">
      <Setter Property="Width" Value="76" />
      <Setter Property="Height" Value="96" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <!-- Button's theme style forces black text; use the panel's. -->
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Background" CornerRadius="4" Padding="2,4" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Background" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Background" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A thin thumb without arrows, in the text color. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Opacity="0.35"
                              Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Frame" Padding="12">
    <StackPanel>
      <!-- The folder's name; hovering shows a pencil, clicking turns it into a box to rename the folder.
           A folder opened from the list of all folders has an arrow back to the list. -->
      <Grid x:Name="HeadingBar" Margin="0,0,0,8" Background="Transparent"
            MouseEnter="OnHeadingEnter" MouseLeave="OnHeadingLeave" MouseLeftButtonUp="OnHeadingClick">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <Border x:Name="BackButton"
                Grid.Column="0"
                Visibility="Collapsed"
                CornerRadius="4"
                Background="Transparent"
                Cursor="Hand"
                MouseEnter="OnBackEnter"
                MouseLeave="OnBackLeave"
                MouseLeftButtonUp="OnBackClick">
          <TextBlock FontFamily="Segoe MDL2 Assets"
                     FontSize="13"
                     Text="&#xE72B;"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="Heading"
                   Grid.Column="1"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBox x:Name="HeadingEditor"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Visibility="Collapsed"
                 FontSize="16"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 Padding="0,0,0,1"
                 BorderThickness="0,0,0,1"
                 Background="Transparent"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                 CaretBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                 BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                 PreviewKeyDown="OnEditorKeyDown"
                 LostKeyboardFocus="OnEditorLostFocus" />
        <TextBlock x:Name="EditGlyph"
                   Grid.Column="2"
                   Opacity="0"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="13"
                   Text="&#xE70F;"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
      </Grid>
      <TextBlock x:Name="EmptyHint" Margin="0,8" Opacity="0.7" TextAlignment="Center" />
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Items">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource ItemButton}" Click="OnItemClick" ToolTip="{Binding Name}"
                      PreviewMouseLeftButtonDown="OnItemPress" PreviewMouseMove="OnItemMove" PreviewMouseLeftButtonUp="OnItemRelease">
                <StackPanel>
                  <!-- A folder (in the list of all folders) sits on a tile, like its widget on the desktop. -->
                  <Border x:Name="Tile" Width="48" Height="48" CornerRadius="10.7">
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                  <TextBlock x:Name="Label"
                             Text="{Binding Name}"
                             Margin="0,4,0,0"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             MaxHeight="34"
                             FontFamily="{x:Static SystemFonts.IconFontFamily}"
                             FontSize="{x:Static SystemFonts.IconFontSize}" />
                </StackPanel>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                  <Setter TargetName="Tile" Property="Background" Value="{DynamicResource TileBrush}" />
                  <Setter TargetName="Tile" Property="Padding" Value="5.8" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Border>
</Window>
