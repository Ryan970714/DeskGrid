<Window x:Class="DeskGrid.Updates.UpdateDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
  <StackPanel Width="420" Margin="20">
    <TextBlock x:Name="Message" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="Hint" Margin="0,12,0,0" Opacity="0.7" TextWrapping="Wrap" />
    <StackPanel x:Name="ProgressArea" Margin="0,16,0,0" Visibility="Collapsed">
      <TextBlock x:Name="ProgressText" Margin="0,0,0,4" />
      <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" />
    </StackPanel>
    <TextBlock x:Name="Error" Margin="0,12,0,0" Foreground="#C42B1C" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="UpdateButton" MinWidth="80" Padding="12,4" IsDefault="True" Click="OnUpdate" />
      <Button x:Name="KeepButton" MinWidth="80" Margin="8,0,0,0" Padding="12,4" Click="OnKeep" />
      <Button x:Name="LaterButton" MinWidth="80" Margin="8,0,0,0" Padding="12,4" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
