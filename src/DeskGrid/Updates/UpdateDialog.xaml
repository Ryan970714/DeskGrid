<Window x:Class="DeskGrid.Updates.UpdateDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20,16,20,20">
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="Message" Style="{StaticResource CardTitle}" FontSize="15" TextWrapping="Wrap" />
        <TextBlock x:Name="Hint" Opacity="0.75" TextWrapping="Wrap" />
        <StackPanel x:Name="ProgressArea" Margin="0,14,0,0" Visibility="Collapsed">
          <TextBlock x:Name="ProgressText" Margin="0,0,0,6" />
          <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock x:Name="Error" Margin="2,4,0,0" Foreground="#C42B1C" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="84" Padding="12,5" x:Name="UpdateButton" IsDefault="True" Click="OnUpdate" />
      <Button MinWidth="84" Padding="12,5" x:Name="KeepButton" Margin="8,0,0,0" Click="OnKeep" />
      <Button MinWidth="84" Padding="12,5" x:Name="LaterButton" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
