<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Window.ThemeMode (Fluent theme) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeskGrid</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Regenerate with tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\DeskGrid.ico</ApplicationIcon>

    <!-- Release builds override Version from the git tag (see .github/workflows/release.yml). -->
    <Version>0.3.1</Version>
    <Product>DeskGrid</Product>
    <Authors>Ryan Kuo</Authors>
    <Copyright>Copyright (c) 2026 Ryan Kuo</Copyright>
    <Description>Phone-style folders on the Windows desktop.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskGrid.Tests" />
  </ItemGroup>

  <!-- Shown by the settings window, so it is always the log of the version that is running. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <!-- Strings is generated into obj/ during the build, too late for WPF's temporary markup assembly:
       XAML must not reference types of this assembly, so dialogs set their texts in code-behind. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>DeskGrid.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
