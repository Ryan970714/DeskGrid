<Application x:Class="DeskGrid.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- Shared by the Fluent windows (settings, new folder). Translucent greys read as a card on both the light
         and the dark Fluent window background. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#14808080" />
      <Setter Property="BorderBrush" Value="#26808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Application.Resources>
</Application>
