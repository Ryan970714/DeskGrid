<Window x:Class="DeskFolders.Panel.PopupPanel"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}">
  <Window.Resources>
    <!-- Set from the theme in code. -->
    <SolidColorBrush x:Key="HoverBrush" Color="Transparent" />

    <Style x:Key="ItemButton" TargetType="Button">
      <Setter Property="Width" Value="76" />
      <Setter Property="Height" Value="96" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <!-- Button's theme style forces black text; use the panel's. -->
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Background" CornerRadius="4" Padding="2,4" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Background" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Background" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A thin thumb without arrows, in the text color. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Opacity="0.35"
                              Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Frame" Padding="12">
    <StackPanel>
      <TextBlock x:Name="Heading"
                 Margin="0,0,0,8"
                 FontSize="16"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="EmptyHint" Margin="0,8" Opacity="0.7" TextAlignment="Center" />
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Items">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource ItemButton}" Click="OnItemClick" ToolTip="{Binding Name}">
                <StackPanel>
                  <Image Source="{Binding Icon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock x:Name="Label"
                             Text="{Binding Name}"
                             Margin="0,4,0,0"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             MaxHeight="34"
                             FontFamily="{x:Static SystemFonts.IconFontFamily}"
                             FontSize="{x:Static SystemFonts.IconFontSize}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Border>
</Window>
